<UserControl x:Class="MeetWise.App.AssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeetWise.App"
             xmlns:try="clr-namespace:MeetWise.App.Try">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="{local:T ai.title}" Style="{StaticResource PageTitle}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="{local:T ai.clear}" ToolTip="{local:T tip.ai.clear}" Click="Clear_Click" VerticalAlignment="Center"/>
            <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ItemText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ContextText" Style="{StaticResource Caption}" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,14,14,6">
            <WrapPanel>
                <Button Content="{local:T ai.cmd.summarize}" Style="{StaticResource Chip}" Click="Command_Click" ToolTip="{local:T tip.ai.summarize}" Tag="Summarize"/>
                <Button Content="{local:T ai.cmd.keypoints}" Style="{StaticResource Chip}" Click="Command_Click" ToolTip="{local:T tip.ai.keypoints}" Tag="KeyPoints"/>
                <Button Content="{local:T ai.cmd.actions}" Style="{StaticResource Chip}" Click="Command_Click" ToolTip="{local:T tip.ai.actions}" Tag="ActionItems"/>
                <Button Content="{local:T ai.cmd.chapters}" Style="{StaticResource Chip}" Click="Command_Click" ToolTip="{local:T tip.ai.chapters}" Tag="Chapters"/>
                <Button Content="{local:T ai.cmd.title}" Style="{StaticResource Chip}" Click="Command_Click" ToolTip="{local:T tip.ai.title}" Tag="TitleAndDescription"/>
                <Button Content="{local:T ai.cmd.email}" Style="{StaticResource Chip}" Click="Command_Click" ToolTip="{local:T tip.ai.email}" Tag="FollowUpEmail"/>
                <Button Content="{local:T ai.cmd.cleanup}" Style="{StaticResource Chip}" Click="Command_Click" ToolTip="{local:T tip.ai.cleanup}" Tag="CleanUp"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{local:T ai.cmd.translate}" Style="{StaticResource Chip}" ToolTip="{local:T tip.ai.translate}" Click="Translate_Click" Margin="0,0,6,0"/>
                    <ComboBox ToolTip="{local:T tip.ai.translatelang}" x:Name="TranslateCombo" Width="170" Height="34" DisplayMemberPath="Text" SelectedValuePath="Value"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" MinHeight="150">
            <Grid>
                <ListBox x:Name="Chat" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="14,10" Margin="0,6" BorderThickness="1"
                                    Background="{Binding Background}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Visibility="{Binding ToolsVisibility}">
                                            <Button Content="{local:T ai.copy}" ToolTip="{local:T tip.ai.copy}" Click="CopyReply_Click" Padding="10,2" Margin="0,0,6,0"/>
                                            <Button Content="{local:T ai.save}" ToolTip="{local:T tip.ai.save}" Click="SaveReply_Click" Padding="10,2"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DockPanel>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" FontSize="15" Margin="0,6,0,0" Padding="0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="{local:T ai.empty}" Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap" MaxWidth="460"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox ToolTip="{local:T tip.ai.input}" x:Name="Input" MinHeight="46" MaxHeight="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Center"
                         Padding="12,10" FontSize="15" PreviewKeyDown="Input_KeyDown" AutomationProperties.Name="Message"/>
                <TextBlock x:Name="Placeholder" Text="{local:T ai.placeholder}" Style="{StaticResource Caption}" FontSize="14" Margin="14,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button ToolTip="{local:T tip.ai.send}" x:Name="SendButton" Content="{local:T ai.send}" Style="{StaticResource AccentButton}" Click="Send_Click" Height="46" MinWidth="96"/>
                <Button ToolTip="{local:T tip.ai.stop}" x:Name="StopButton" Content="{local:T ai.stop}" Click="Stop_Click" Height="46" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
        <try:QuickTest x:Name="AiTest" Grid.Row="7" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
