<Window x:Class="MeetWise.App.VoiceProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetWise.App"
        Title="{local:T voice.title}" Width="620" Height="620" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{local:T voice.title}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,14"
                   Text="{local:T voice.intro}"/>

        <TextBlock x:Name="StepText" Grid.Row="2" FontWeight="SemiBold"/>
        <Border Grid.Row="3" Margin="0,6,0,10" Style="{StaticResource Card}" Padding="16" CornerRadius="8">
            <TextBlock x:Name="PromptText" FontSize="20" TextWrapping="Wrap" MinHeight="64"/>
        </Border>

        <StackPanel Grid.Row="4">
            <ProgressBar ToolTip="{local:T tip.voice.level}" x:Name="LevelBar" Height="10" Minimum="0" Maximum="1"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button ToolTip="{local:T tip.voice.record}" x:Name="RecordButton" Grid.Column="1" Content="{local:T voice.start}" Width="150" Height="38" Click="Record_Click" IsEnabled="False"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Name="TestPanel" Grid.Row="5" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="{local:T voice.testtitle}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                       Text="{local:T voice.testintro}"/>
            <WrapPanel>
                <Button ToolTip="{local:T tip.voice.test}" x:Name="TestRecordButton" Content="{local:T voice.testrec}" Width="140" Height="32" Margin="0,0,8,0" Click="TestRecord_Click"/>
                <Button ToolTip="{local:T tip.voice.playraw}" x:Name="PlayRawButton" Content="{local:T voice.playraw}" Width="120" Height="32" Margin="0,0,8,0" IsEnabled="False" Click="PlayRaw_Click"/>
                <Button ToolTip="{local:T tip.voice.playlocked}" x:Name="PlayLockedButton" Content="{local:T voice.playlocked}" Width="140" Height="32" IsEnabled="False" Click="PlayLocked_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TestResultText" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button ToolTip="{local:T tip.voice.delete}" x:Name="DeleteButton" Content="{local:T voice.delete}" Margin="0,0,8,0" Padding="12,4" Visibility="Collapsed" Click="Delete_Click"/>
            <Button ToolTip="{local:T tip.voice.close}" x:Name="CloseButton" Content="{local:T voice.close}" Width="90" Padding="12,4" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
