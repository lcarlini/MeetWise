<UserControl x:Class="MeetWise.App.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeetWise.App">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- everything recorded or imported -->
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <TextBlock Text="{local:T lib.title}" Style="{StaticResource PageTitle}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Grid Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Height="36" VerticalContentAlignment="Center" Padding="10,0" TextChanged="Search_Changed" AutomationProperties.Name="Search"/>
                    <TextBlock x:Name="SearchHint" Text="{local:T lib.search}" Style="{StaticResource Caption}" FontSize="14" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="ItemGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="None" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" MouseDoubleClick="Item_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="40" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            <DataGridTextColumn Header="" Binding="{Binding Title}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="2,6"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="" Binding="{Binding KindText}" Width="110"/>
                            <DataGridTextColumn Header="" Binding="{Binding Date}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Text="{local:T lib.empty}" Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="4">
                <Button Content="{local:T lib.open.sub}" Style="{StaticResource AccentButton}" Click="OpenSubtitles_Click" Margin="0,0,8,0"/>
                <Button Content="{local:T lib.open.ai}" Click="OpenAssistant_Click" Margin="0,0,8,0"/>
                <Button Content="{local:T lib.folder}" Click="OpenFolder_Click" Margin="0,0,8,0"/>
                <Button Content="{local:T lib.rename}" Click="Rename_Click" Margin="0,0,8,0"/>
                <Button Content="{local:T lib.delete}" Click="Delete_Click"/>
            </WrapPanel>
        </Grid>

        <!-- importing -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{local:T lib.import}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T lib.opt.language}" Style="{StaticResource Caption}"/>
                        <ComboBox x:Name="ImportLanguage" Margin="0,4,0,8" DisplayMemberPath="Text" SelectedValuePath="Value"/>
                        <CheckBox x:Name="ImportTranslate" Content="{local:T lib.opt.translate}" Margin="0,0,0,2"/>
                        <CheckBox x:Name="ImportNoise" Content="{local:T lib.opt.noise}" Margin="0,0,0,2"/>
                        <CheckBox x:Name="ImportSrt" Content="{local:T lib.opt.srt}" IsChecked="True" Margin="0,0,0,10"/>
                        <Button Content="{local:T lib.import}" Click="ImportFiles_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="{local:T lib.youtube}" Style="{StaticResource CardTitle}" Margin="0,18,0,8"/>
                        <Grid>
                            <TextBox x:Name="YouTubeBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" AutomationProperties.Name="YouTube link"/>
                            <TextBlock x:Name="YouTubeHint" Text="{local:T lib.youtube.hint}" Style="{StaticResource Caption}" Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="{local:T lib.youtube}" Click="ImportYouTube_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <CheckBox x:Name="WatchCheck" Content="{local:T lib.watch}" FontWeight="SemiBold" Click="Watch_Click"/>
                        <TextBlock Text="{local:T lib.watch.folder}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="…" Width="36" Click="WatchFolder_Click" Margin="6,0,0,0"/>
                            <TextBox x:Name="WatchPath" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="WatchHelp" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{local:T lib.jobs}" Style="{StaticResource CardTitle}"/>
                        <ItemsControl x:Name="Jobs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="5" Margin="0,4,0,0" Visibility="{Binding BarVisibility}"/>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding MessageVisibility}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
