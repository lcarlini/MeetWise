<UserControl x:Class="MeetWise.App.SubtitlesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeetWise.App">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="{local:T sub.title}" Style="{StaticResource PageTitle}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefineButton" Content="{local:T sub.refine}" Click="Refine_Click" Margin="8,0,0,0"/>
                <Button x:Name="OpenVideoButton" Content="{local:T sub.openvideo}" Click="OpenVideo_Click" Margin="8,0,0,0"/>
            </WrapPanel>
            <ComboBox x:Name="ItemCombo" MinWidth="320" MaxWidth="560" Margin="24,0,0,0" HorizontalAlignment="Left" DisplayMemberPath="Display"
                      SelectionChanged="Item_Changed" AutomationProperties.Name="Recording"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="{local:T sub.copytext}" Click="CopyText_Click" Margin="6,0,0,0"/>
                    <Button Content="{local:T sub.copysrt}" Click="CopySrt_Click" Margin="6,0,0,0"/>
                    <Button Content="{local:T sub.savesrt}" Click="SaveSrt_Click" Margin="6,0,0,0" Style="{StaticResource AccentButton}"/>
                    <Button Content="{local:T sub.savevtt}" Click="SaveVtt_Click" Margin="6,0,0,0"/>
                    <Button Content="{local:T sub.savetxt}" Click="SaveTxt_Click" Margin="6,0,0,0"/>
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="{local:T sub.selectall}" Click="SelectAll_Click" Margin="0,0,6,0"/>
                    <Button Content="{local:T sub.selectnone}" Click="SelectNone_Click" Margin="0,0,6,0"/>
                    <Button Content="{local:T sub.invert}" Click="Invert_Click" Margin="0,0,12,0"/>
                    <TextBox x:Name="FilterBox" Width="190" TextChanged="Filter_Changed" VerticalContentAlignment="Center" AutomationProperties.Name="Filter"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" SelectionMode="Single" Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                          CellEditEnding="Grid_CellEditEnding" PreviewKeyDown="Grid_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RowCheck_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:T sub.col.time}" Binding="{Binding Time, Mode=OneWay}" IsReadOnly="True" Width="76"/>
                        <DataGridTextColumn Header="{local:T sub.col.speaker}" Binding="{Binding Speaker, Mode=TwoWay}" Width="110"/>
                        <DataGridTextColumn Header="{local:T sub.col.text}" Binding="{Binding Text, Mode=TwoWay}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4,6"/><Setter Property="FontSize" Value="15"/></Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="False"/><Setter Property="FontSize" Value="15"/></Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="{local:T sub.empty}" Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{local:T sub.ask}" Click="Ask_Click" Style="{StaticResource AccentButton}"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
