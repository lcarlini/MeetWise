<Window x:Class="MeetWise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetWise.App"
        Title="MeetWise" Icon="pack://application:,,,/meetwise.ico" Width="640" Height="900" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="22,18,22,22">

            <!-- header -->
            <DockPanel Margin="0,0,0,14">
                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="130" VerticalAlignment="Center" DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="Language_Changed" AutomationProperties.Name="Language"/>
                <StackPanel>
                    <TextBlock Text="MeetWise" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:T app.subtitle}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </DockPanel>

            <!-- on/off -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="PowerButton" DockPanel.Dock="Right" MinWidth="130" Height="44" FontSize="15" FontWeight="SemiBold" Click="Power_Click"
                                AutomationProperties.AutomationId="PowerButton"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StateTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="20,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ProblemText" Foreground="#FFE5484D" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="InstallButton" Content="{local:T mic.install}" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="Install_Click" Visibility="Collapsed"/>
                        <Button x:Name="RepairButton" Content="{local:T mic.repair}" Margin="0,0,8,6" Padding="12,6" Click="Repair_Click" Visibility="Collapsed"/>
                        <Button x:Name="DefaultButton" Content="{local:T mic.makedefault}" Margin="0,0,8,6" Padding="12,6" Click="Default_Click" ToolTip="{local:T tip.makedefault}"/>
                        <Button x:Name="RestoreButton" Content="{local:T mic.restore}" Margin="0,0,8,6" Padding="12,6" Click="Restore_Click"/>
                    </WrapPanel>
                    <TextBlock Text="{local:T mic.howto}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- microphone and meters -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{local:T mic.source}" Style="{StaticResource CardTitle}"/>
                    <ComboBox x:Name="MicCombo" SelectionChanged="Mic_Changed" AutomationProperties.Name="Microphone"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{local:T meter.in}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="InMeter" Grid.Column="1" Height="10" Minimum="0" Maximum="1" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="{local:T meter.out}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="OutMeter" Grid.Row="1" Grid.Column="1" Height="10" Minimum="0" Maximum="1" Margin="0,4"/>
                    </Grid>
                    <TextBlock x:Name="StatsText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- effects -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{local:T fx.title}" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{local:T fx.engine}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton x:Name="EngineMeetWise" GroupName="engine" Content="MeetWise" Margin="0,0,16,0" Click="Engine_Click"
                                     AutomationProperties.AutomationId="EngineMeetWise"/>
                        <RadioButton x:Name="EngineBroadcast" GroupName="engine" Content="NVIDIA Broadcast" Click="Engine_Click"
                                     AutomationProperties.AutomationId="EngineBroadcast"/>
                    </StackPanel>
                    <TextBlock x:Name="EngineHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <DockPanel>
                        <ComboBox x:Name="NoiseModeBox" DockPanel.Dock="Right" Width="170" DisplayMemberPath="Text" SelectedValuePath="Value" SelectionChanged="Setting_Changed"/>
                        <CheckBox x:Name="NoiseCheck" Content="{local:T fx.noise}" Click="Setting_Changed" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{local:T fx.noise.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,4"/>
                    <DockPanel Margin="28,0,0,10">
                        <TextBlock x:Name="StrengthValue" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:T fx.strength}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Strength_Changed"
                                AutomationProperties.Name="Strength"/>
                    </DockPanel>

                    <CheckBox x:Name="EchoCheck" Content="{local:T fx.echo}" Click="Setting_Changed" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:T fx.echo.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,10"/>

                    <DockPanel>
                        <Button x:Name="TrainButton" DockPanel.Dock="Right" Content="{local:T fx.train}" Padding="12,4" Click="Train_Click"/>
                        <CheckBox x:Name="VoicesCheck" Content="{local:T fx.voices}" Click="Voices_Click" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock x:Name="VoicesHint" Text="{local:T fx.voices.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,10"/>

                    <CheckBox x:Name="GainCheck" Content="{local:T fx.gain}" Click="Setting_Changed" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:T fx.gain.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- accent assist (phase 2) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{local:T accent.title}" Style="{StaticResource CardTitle}"/>
                    <CheckBox x:Name="AccentCheck" Content="{local:T accent.enable}" Click="Accent_Click" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccentHint" Text="{local:T accent.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,6"/>
                    <DockPanel Margin="28,0,0,0">
                        <TextBlock x:Name="AccentValue" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:T accent.strength}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="AccentSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="AccentStrength_Changed"
                                AutomationProperties.Name="Accent strength"/>
                    </DockPanel>
                    <TextBlock x:Name="AccentStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- tests -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{local:T test.title}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{local:T test.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="ZoomTestButton" Content="{local:T test.zoom}" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="ZoomTest_Click"
                                AutomationProperties.AutomationId="ZoomTestButton"/>
                        <Button x:Name="PlayRawButton" Content="{local:T test.playraw}" Margin="0,0,8,6" Padding="12,6" IsEnabled="False" Click="PlayRaw_Click"/>
                        <Button x:Name="PlayCleanButton" Content="{local:T test.playclean}" Margin="0,0,8,6" Padding="12,6" IsEnabled="False" Click="PlayClean_Click"/>
                        <Button x:Name="CheckButton" Content="{local:T test.check}" Margin="0,0,8,6" Padding="12,6" Click="Check_Click"
                                AutomationProperties.AutomationId="CheckButton"/>
                    </WrapPanel>
                    <ProgressBar x:Name="TestProgress" Height="4" Minimum="0" Maximum="1" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TestText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- footer -->
            <CheckBox x:Name="StartupCheck" Content="{local:T app.startup}" Click="Startup_Click" Margin="2,0,0,6"/>
            <TextBlock Text="{local:T app.closehint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
