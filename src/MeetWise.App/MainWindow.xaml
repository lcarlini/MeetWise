<Window x:Class="MeetWise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetWise.App"
        Title="MeetWise Studio" Icon="pack://application:,,,/meetwise.ico" Width="1280" Height="820" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <Border Background="{StaticResource Studio.Rail}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                    <TextBlock Text="MeetWise" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="STUDIO" FontSize="11" FontWeight="SemiBold" Foreground="#FF7C8DCB" Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,16">
                    <RadioButton ToolTip="{local:T tip.nav.settings}" x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" GroupName="none" Click="Settings_Click" Margin="-6,0,-6,8">
                        <TextBlock Text="{local:T nav.settings}"/>
                    </RadioButton>
                    <TextBlock Text="{local:T set.language}" Foreground="#FF7C8DCB" FontSize="11" Margin="4,0,0,4"/>
                    <ComboBox ToolTip="{local:T tip.nav.language}" x:Name="LanguageBox" DisplayMemberPath="Text" SelectedValuePath="Value" SelectionChanged="Language_Changed"/>
                    <TextBlock x:Name="HardwareText" Foreground="#FF7C8DCB" FontSize="11" TextWrapping="Wrap" Margin="4,12,0,0"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton ToolTip="{local:T tip.nav.record}" x:Name="NavRecord" Style="{StaticResource NavButton}" Tag="&#xE714;" GroupName="nav" IsChecked="True" Click="Nav_Click" CommandParameter="record">
                        <TextBlock Text="{local:T nav.record}"/>
                    </RadioButton>
                    <RadioButton ToolTip="{local:T tip.nav.subtitles}" x:Name="NavSubtitles" Style="{StaticResource NavButton}" Tag="&#xE7F0;" GroupName="nav" Click="Nav_Click" CommandParameter="subtitles">
                        <TextBlock Text="{local:T nav.subtitles}"/>
                    </RadioButton>
                    <RadioButton ToolTip="{local:T tip.nav.assistant}" x:Name="NavAssistant" Style="{StaticResource NavButton}" Tag="&#xE99A;" GroupName="nav" Click="Nav_Click" CommandParameter="assistant">
                        <TextBlock Text="{local:T nav.assistant}"/>
                    </RadioButton>
                    <RadioButton ToolTip="{local:T tip.nav.library}" x:Name="NavLibrary" Style="{StaticResource NavButton}" Tag="&#xE8F1;" GroupName="nav" Click="Nav_Click" CommandParameter="library">
                        <TextBlock Text="{local:T nav.library}"/>
                    </RadioButton>
                    <RadioButton ToolTip="{local:T tip.nav.meetings}" x:Name="NavMeetings" Style="{StaticResource NavButton}" Tag="&#xE716;" GroupName="nav" Click="Nav_Click" CommandParameter="meetings">
                        <TextBlock Text="{local:T nav.meetings}"/>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- pages -->
        <Grid Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid x:Name="Pages"/>
            <Border x:Name="ToastBorder" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="18,10"
                    CornerRadius="10" Background="#E61C2340">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="720"/>
            </Border>
        </Grid>
    </Grid>
</Window>
