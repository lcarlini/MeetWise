<Window x:Class="MeetWise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetWise" Width="560" Height="420" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MeetWise" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="HardwareText" Grid.Row="1" Margin="0,4,0,16" TextWrapping="Wrap" Opacity="0.7"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Microphone" Margin="0,0,0,4"/>
            <ComboBox x:Name="MicCombo" Margin="0,0,0,10"/>
            <TextBlock Text="Capture mode" Margin="0,0,0,4"/>
            <ComboBox x:Name="PresetCombo" Margin="0,0,0,10"/>
            <TextBlock Text="Noise cancellation (engine arrives in phase 3)" Margin="0,0,0,4"/>
            <ComboBox x:Name="NoiseCombo"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,16,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <Button x:Name="RecordButton" Grid.Row="4" Content="Start recording" Height="44" FontSize="16" Click="RecordButton_Click"/>
    </Grid>
</Window>
