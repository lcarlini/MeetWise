<Window x:Class="MeetWise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetWise" Width="760" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MeetWise" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="HardwareText" Grid.Row="1" Margin="0,4,0,12" TextWrapping="Wrap" Opacity="0.7"/>

        <StackPanel Grid.Row="2"><Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Microphone" Margin="0,0,0,4"/><ComboBox x:Name="MicCombo"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Capture mode" Margin="0,0,0,4"/><ComboBox x:Name="PresetCombo"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Noise cancellation" Margin="0,0,0,4"/><ComboBox x:Name="NoiseCombo"/></StackPanel>
        </Grid>
        <Expander Header="Audio enhancement (microphone cleanup for any meeting app)" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                           Text="Cleaned audio is sent to the output device below. Choose a virtual cable (or the MeetWise virtual microphone) and select its matching input as the microphone in Zoom, Teams or Meet."/>
                <TextBlock x:Name="VirtualHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="DarkOrange"
                           Text="No virtual audio device was found, so meeting apps cannot receive the cleaned microphone yet. Install the free VB-CABLE (vb-audio.com/Cable), restart MeetWise, pick &quot;CABLE Input&quot; here, and choose &quot;CABLE Output&quot; as the microphone in Zoom, Teams or Meet. Live transcription and recording work without it."/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="RenderCombo"/>
                    <Button x:Name="EnhanceButton" Grid.Column="1" Content="Start cleanup" Width="120" Margin="8,0,0,0" Click="Enhance_Click"/>
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox x:Name="EchoCheck" Content="Echo cancellation" IsChecked="True" Margin="0,0,16,0"/>
                    <CheckBox x:Name="IsolateCheck" Content="Voice isolation" Margin="0,0,16,0"/>
                    <Button Content="Enroll my voice (10 s)" Click="Enroll_Click" Padding="10,2"/>
                </WrapPanel>
            </StackPanel>
        </Expander></StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="28" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"
                     ToolTip="Type words to search transcripts, or a question for Ask"/>
            <Button Grid.Column="1" Content="Search" Width="80" Margin="8,0,0,0" Click="Search_Click"/>
            <Button Grid.Column="2" Content="Import…" Width="70" Margin="8,0,0,0" Click="Import_Click"/>
            <Button Grid.Column="3" Content="Ask" Width="56" Margin="8,0,0,0" Click="Ask_Click" ToolTip="Ask a question about your meetings (uses the text box)"/>
            <Button Grid.Column="4" Content="Notes" Width="64" Margin="8,0,0,0" Click="Notes_Click" ToolTip="Generate notes and action items for the latest meeting"/>
            <Button Grid.Column="5" Content="Actions" Width="64" Margin="8,0,0,0" Click="Actions_Click" ToolTip="Open action items across all meetings"/>
            <Button Grid.Column="7" Content="Refine" Width="64" Margin="8,0,0,0" Click="Refine_Click" ToolTip="Re-transcribe the latest meeting with the high-accuracy multilingual model"/>
            <Button Grid.Column="6" Content="Settings" Width="70" Margin="8,0,0,0" Click="Settings_Click"/>
        </Grid>

        <ListBox x:Name="TranscriptList" Grid.Row="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,2">
                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="Gray"/>
                        <Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="{Binding Text, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,10,0,10" TextWrapping="Wrap"/>
        <Button x:Name="RecordButton" Grid.Row="6" Content="Start recording" Height="44" FontSize="16" Click="RecordButton_Click"/>
    </Grid>
</Window>
