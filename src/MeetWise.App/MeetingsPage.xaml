<UserControl x:Class="MeetWise.App.MeetingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeetWise.App"
             xmlns:try="clr-namespace:MeetWise.App.Try">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{local:T nav.meetings}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{local:T mtg.subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,18"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{local:T mtg.mic.title}" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Width="340" Margin="0,0,16,8"><TextBlock Text="{local:T mtg.mic.which}" Style="{StaticResource Caption}"/><ComboBox ToolTip="{local:T tip.mic.mic}" x:Name="MicCombo" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Width="150" Margin="0,0,0,8"><TextBlock Text="{local:T mtg.mic.noise}" Style="{StaticResource Caption}"/><ComboBox ToolTip="{local:T tip.mic.noise}" x:Name="NoiseCombo" Margin="0,4,0,0"/></StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="MicStatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button ToolTip="{local:T tip.mic.create}" x:Name="CreateMicButton" Content="{local:T mtg.mic.create}" Padding="12,5" Margin="0,0,8,6" Click="CreateMic_Click"/>
                        <Button ToolTip="{local:T tip.mic.default}" x:Name="DefaultMicButton" Content="{local:T mtg.mic.default}" Padding="12,5" Margin="0,0,8,6" Click="DefaultMic_Click"/>
                        <Button ToolTip="{local:T tip.mic.restore}" x:Name="RestoreMicButton" Content="{local:T mtg.mic.restore}" Padding="12,5" Margin="0,0,8,6" Click="RestoreMic_Click"/>
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox ToolTip="{local:T tip.mic.alwayson}" x:Name="AlwaysOnCheck" Content="{local:T mtg.mic.alwayson}" Margin="0,0,16,6" Click="AlwaysOn_Click"/>
                        <CheckBox ToolTip="{local:T tip.mic.startup}" x:Name="StartupCheck" Content="{local:T mtg.mic.startup}" Margin="0,0,16,6" Click="Startup_Click"/>
                        <CheckBox ToolTip="{local:T tip.mic.echo}" x:Name="EchoCheck" Content="{local:T mtg.mic.echo}" IsChecked="True" Margin="0,0,16,6"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,2,0,0">
                        <CheckBox ToolTip="{local:T tip.mic.isolate}" x:Name="IsolateCheck" Content="{local:T mtg.mic.isolate}" Margin="0,0,12,6" Click="Isolate_Click"/>
                        <Button Content="{local:T mtg.mic.train}" Padding="10,3" Margin="0,0,16,6" ToolTip="{local:T tip.mic.train}" Click="VoiceProfile_Click"/>
                        <CheckBox ToolTip="{local:T tip.mic.coach}" x:Name="CoachCheck" Content="{local:T mtg.mic.coach}" Margin="0,0,12,6"/>
                        <CheckBox ToolTip="{local:T tip.mic.overlay}" x:Name="CoachOverlayCheck" Content="{local:T mtg.mic.overlay}" IsChecked="True" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <try:QuickTest x:Name="MicTest"/>
                    <try:QuickTest x:Name="CoachTest"/>
                    <TextBlock x:Name="VirtualHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="DarkOrange"/>
                    <Expander Header="{local:T mtg.mic.advanced}" Margin="0,4,0,0">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ToolTip="{local:T tip.mic.render}" x:Name="RenderCombo"/>
                            <Button ToolTip="{local:T tip.mic.enhance}" x:Name="EnhanceButton" Grid.Column="1" Content="{local:T mtg.mic.start}" Width="120" Margin="8,0,0,0" Click="Enhance_Click"/>
                        </Grid>
                    </Expander>
                    <TextBlock Margin="0,10,0,0" FontSize="11" Opacity="0.65" TextWrapping="Wrap">
                        <Run Text="The MeetWise Microphone is powered by VB-CABLE, a virtual audio driver by VB-Audio (www.vb-cable.com). VB-CABLE is donationware: all participations are welcome. "/>
                        <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="Link_Navigate">Donate or learn more</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>


            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{local:T mtg.notes.title}" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox ToolTip="{local:T tip.mtg.search}" x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                        <Button Grid.Column="1" Content="{local:T mtg.search}" MinWidth="84" Padding="12,4" Margin="8,0,0,0" ToolTip="{local:T tip.mtg.searchbtn}" Click="Search_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="{local:T mtg.ask}" MinWidth="70" Padding="12,4" Margin="0,0,8,4" ToolTip="{local:T tip.mtg.ask}" Click="Ask_Click"/>
                        <Button Content="{local:T mtg.notes}" MinWidth="80" Padding="12,4" Margin="0,0,8,4" ToolTip="{local:T tip.mtg.notes}" Click="Notes_Click"/>
                        <Button Content="{local:T mtg.actions}" MinWidth="110" Padding="12,4" Margin="0,0,8,4" ToolTip="{local:T tip.mtg.actions}" Click="Actions_Click"/>
                    </WrapPanel>
                    <ListBox ToolTip="{local:T tip.mtg.list}" x:Name="TranscriptList" Height="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="Gray"/>
                                    <Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
