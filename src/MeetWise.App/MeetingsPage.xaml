<UserControl x:Class="MeetWise.App.MeetingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeetWise.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{local:T nav.meetings}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Clean microphone for every app, voice lock, live translation, the English coach and meeting notes." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,18"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="MeetWise Microphone: clean voice for every app" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Width="340" Margin="0,0,16,8"><TextBlock Text="Microphone to clean" Style="{StaticResource Caption}"/><ComboBox x:Name="MicCombo" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Width="150" Margin="0,0,0,8"><TextBlock Text="Noise cancellation" Style="{StaticResource Caption}"/><ComboBox x:Name="NoiseCombo" Margin="0,4,0,0"/></StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="MicStatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="CreateMicButton" Content="Create MeetWise Microphone" Padding="12,5" Margin="0,0,8,6" Click="CreateMic_Click"/>
                        <Button x:Name="DefaultMicButton" Content="Make it my Windows default" Padding="12,5" Margin="0,0,8,6" Click="DefaultMic_Click"/>
                        <Button x:Name="RestoreMicButton" Content="Restore my previous microphone" Padding="12,5" Margin="0,0,8,6" Click="RestoreMic_Click"/>
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox x:Name="AlwaysOnCheck" Content="Always on (clean my microphone for every app)" Margin="0,0,16,6" Click="AlwaysOn_Click"/>
                        <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,0,16,6" Click="Startup_Click"/>
                        <CheckBox x:Name="EchoCheck" Content="Echo cancellation" IsChecked="True" Margin="0,0,16,6"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,2,0,0">
                        <CheckBox x:Name="IsolateCheck" Content="Voice lock: pass only my voice" Margin="0,0,12,6" Click="Isolate_Click"/>
                        <Button Content="Train my voice…" Padding="10,3" Margin="0,0,16,6" Click="VoiceProfile_Click"/>
                        <CheckBox x:Name="CoachCheck" Content="English coach (private corrections on screen)" Margin="0,0,12,6"/>
                        <CheckBox x:Name="CoachOverlayCheck" Content="Show floating coach" IsChecked="True" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="VirtualHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="DarkOrange"/>
                    <Expander Header="Advanced: send the cleaned audio to another device" Margin="0,4,0,0">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RenderCombo"/>
                            <Button x:Name="EnhanceButton" Grid.Column="1" Content="Start cleanup" Width="120" Margin="8,0,0,0" Click="Enhance_Click"/>
                        </Grid>
                    </Expander>
                    <TextBlock Margin="0,10,0,0" FontSize="11" Opacity="0.65" TextWrapping="Wrap">
                        <Run Text="The MeetWise Microphone is powered by VB-CABLE, a virtual audio driver by VB-Audio (www.vb-cable.com). VB-CABLE is donationware: all participations are welcome. "/>
                        <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="Link_Navigate">Donate or learn more</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Meeting notes and questions" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"
                                 ToolTip="Type words to search transcripts, or a question for Ask"/>
                        <Button Grid.Column="1" Content="Search" Width="84" Margin="8,0,0,0" Click="Search_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Ask" Width="70" Margin="0,0,8,4" Click="Ask_Click" ToolTip="Ask a question about your meetings (uses the text box)"/>
                        <Button Content="Notes" Width="80" Margin="0,0,8,4" Click="Notes_Click" ToolTip="Generate notes and action items for the latest meeting"/>
                        <Button Content="Action items" Width="110" Margin="0,0,8,4" Click="Actions_Click" ToolTip="Open action items across all meetings"/>
                    </WrapPanel>
                    <ListBox x:Name="TranscriptList" Height="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="Gray"/>
                                    <Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
