<Window x:Class="MeetWise.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetWise.App"
        xmlns:try="clr-namespace:MeetWise.App.Try"
        Title="MeetWise settings" Width="560" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="AI engine" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,2,0,8"
                       Text="Everything runs locally by default. An API key is an optional upgrade for notes and answers; audio never leaves this PC."/>
            <ComboBox ToolTip="{local:T tip.set.provider}" x:Name="ProviderCombo" SelectionChanged="ProviderCombo_Changed" Margin="0,0,0,8">
                <ComboBoxItem Tag="" Content="Local model (private, offline)"/>
                <ComboBoxItem Tag="anthropic" Content="Anthropic (Claude) API key"/>
                <ComboBoxItem Tag="openai-compatible" Content="OpenAI-compatible server (OpenAI, Ollama, LM Studio)"/>
            </ComboBox>
            <StackPanel x:Name="CloudPanel">
                <TextBlock Text="Server URL (OpenAI-compatible only)"/>
                <TextBox ToolTip="{local:T tip.set.url}" x:Name="UrlBox" Margin="0,2,0,8"/>
                <TextBlock Text="Model name"/>
                <TextBox ToolTip="{local:T tip.set.model}" x:Name="ModelBox" Margin="0,2,0,8"/>
                <TextBlock Text="API key (stored encrypted for your Windows account)"/>
                <PasswordBox x:Name="KeyBox" Margin="0,2,0,8"/>
            </StackPanel>

            <TextBlock Text="Meeting notes" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock Text="Spoken language (used by the Refine pass)"/>
            <ComboBox ToolTip="{local:T tip.set.lang}" x:Name="LangCombo" Margin="0,2,0,8" DisplayMemberPath="Value" SelectedValuePath="Key"/>
            <TextBlock Text="Template"/>
            <ComboBox ToolTip="{local:T tip.set.template}" x:Name="TemplateCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2,0,8"/>
            <TextBlock Text="About you (makes summaries and answers fit your role)"/>
            <TextBox ToolTip="{local:T tip.set.nick}" x:Name="NickBox" Margin="0,2,0,4"/>
            <TextBox ToolTip="{local:T tip.set.occ}" x:Name="OccBox" Margin="0,0,0,4"/>
            <TextBox ToolTip="{local:T tip.set.ctx}" x:Name="CtxBox" Height="52" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

            <TextBlock Text="Custom vocabulary (one term per line)" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBox ToolTip="{local:T tip.set.glossary}" x:Name="GlossaryBox" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <WrapPanel Margin="0,4,0,8">
                <TextBlock Text="Add starter kit: " VerticalAlignment="Center"/>
                <Button Content="Software" Margin="4,0" Padding="8,2" Click="Kit_Click" ToolTip="{local:T tip.set.kit.software}" Tag="software"/>
                <Button Content="Sales" Margin="4,0" Padding="8,2" Click="Kit_Click" ToolTip="{local:T tip.set.kit.sales}" Tag="sales"/>
                <Button Content="Medical" Margin="4,0" Padding="8,2" Click="Kit_Click" ToolTip="{local:T tip.set.kit.medical}" Tag="medical"/>
                <Button Content="Legal" Margin="4,0" Padding="8,2" Click="Kit_Click" ToolTip="{local:T tip.set.kit.legal}" Tag="legal"/>
            </WrapPanel>

            <TextBlock Text="Live translation" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock Text="Show other people's speech as captions in"/>
            <ComboBox ToolTip="{local:T tip.set.captionlang}" x:Name="CaptionLangCombo" Margin="0,2,0,8" DisplayMemberPath="Value" SelectedValuePath="Key"/>
            <TextBlock Text="Speak my voice, translated to (output goes to the device below)"/>
            <ComboBox ToolTip="{local:T tip.set.speaklang}" x:Name="SpeakLangCombo" Margin="0,2,0,4" DisplayMemberPath="Value" SelectedValuePath="Key"/>
            <ComboBox ToolTip="{local:T tip.set.speakdevice}" x:Name="SpeakDeviceCombo" Margin="0,0,0,4" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
            <TextBlock Text="Caption delay" Margin="0,4,0,0"/>
            <ComboBox ToolTip="{local:T tip.set.hold}" x:Name="HoldCombo" Margin="0,2,0,4" DisplayMemberPath="Value" SelectedValuePath="Key"/>
            <CheckBox ToolTip="{local:T tip.set.fallback}" x:Name="FallbackCheck" Margin="0,4,0,4"><TextBlock TextWrapping="Wrap" Text="If a cloud AI fails, use the local model when it is installed (the local model never sends anything out)"/></CheckBox>
            <try:QuickTest x:Name="TranslationTest"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                       Text="Translation uses the AI engine selected above. Spoken output uses the offline Windows voices installed for that language (Settings, Time and language, Speech). Choose the virtual microphone as the device so meeting apps hear it."/>

            <CheckBox ToolTip="{local:T tip.set.hide}" x:Name="HideCheck" Content="Keep MeetWise windows out of screen recordings (restart to apply)" Margin="0,12,0,0"/>

            <TextBlock Text="Calendar" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="Paste your calendar's iCal feed address (Google Calendar: Settings, Integrate calendar, Secret address in iCal format; Outlook: published calendar ICS link)."/>
            <TextBox ToolTip="{local:T tip.set.calendar}" x:Name="CalendarBox" Margin="0,4,0,4"/>
            <CheckBox ToolTip="{local:T tip.set.detect}" x:Name="DetectCheck" Content="Offer to record when Zoom, Teams, Meet and similar apps start using the microphone" Margin="0,0,0,8"/>

            <TextBlock Text="Action item webhook URL (optional)" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBox ToolTip="{local:T tip.set.webhook}" x:Name="WebhookBox" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Width="90" IsDefault="True" ToolTip="{local:T tip.set.save}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
