<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MeetWise.Core\MeetWise.Core.csproj" />
    <ProjectReference Include="..\MeetWise.Audio\MeetWise.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- the Accent Assist worker runs in the accent pack's Python environment; the scripts ship with the program -->
    <None Include="..\..\accent\worker.py" Link="accent\worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\accent\mwaccent\*.py" Link="accent\mwaccent\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="meetwise.ico" />
    <InternalsVisibleTo Include="MeetWise.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Version>0.1.0</Version>
    <AssemblyName>MeetWise.App</AssemblyName>
    <Product>MeetWise</Product>
    <ApplicationIcon>meetwise.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
